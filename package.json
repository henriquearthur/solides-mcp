{
  "name": "solides-mcp",
  "version": "0.1.0",
  "description": "Servidor MCP para a API Gestão da Sólides (não afiliado à Sólides).",
  "license": "MIT",
  "type": "module",
  "bin": {
    "solides-mcp": "dist/stdio/bin.js"
  },
  "exports": {
    ".": "./dist/core/index.js"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "tsx scripts/smoke.ts",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/henriquearthur/solides-mcp.git"
  },
  "keywords": [
    "mcp",
    "solides",
    "model-context-protocol"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
